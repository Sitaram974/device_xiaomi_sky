on boot
    # Force TCP BBR (Fast Internet & Lower Ping)
    write /proc/sys/net/ipv4/tcp_congestion_control bbr
    write /proc/sys/net/ipv4/tcp_fastopen 3
    write /proc/sys/net/core/default_qdisc fq

    # Advanced I/O Scheduler (Storage ko fatafat banayega)
    write /sys/block/sda/queue/scheduler kyber
    write /sys/block/sda/queue/read_ahead_kb 2048
    write /sys/block/sda/queue/nr_requests 512

    # CPU Governor Boost (Instant App Launch)
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us 10000

    # Disable Debugging Traces (Save CPU/RAM)
    write /sys/kernel/debug/tracing/tracing_on 0
